PORT=3000

# postgres | mysql | mongodb | clickhouse
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=simple_site

# Optional full URL (used by MongoDB and ClickHouse instead of host/port)
# DB_URL=mongodb://root:root@localhost:27017
# DB_URL=http://localhost:8123

# Create the visits/messages tables (or MongoDB index) on startup.
DB_AUTO_CREATE_SCHEMA=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
